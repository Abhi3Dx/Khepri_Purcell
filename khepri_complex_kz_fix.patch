diff --git a/khepri/tools.py b/khepri/tools.py
--- a/khepri/tools.py
+++ b/khepri/tools.py
@@
 from .constants import *
@@
 from itertools import product
 
+
+def outgoing_kz(kz_squared, atol=1e-12):
+    """Return the Khepri outgoing/decaying branch of ``sqrt(kz_squared)``.
+
+    Khepri propagates a +z mode with ``exp(-1j*kz*z)``.  Therefore:
+
+    * propagating modes use the root with Re(kz) >= 0;
+    * purely evanescent modes use the root with Im(kz) <= 0.
+
+    Crucially, this function changes the *sign* of a square root when needed;
+    it never complex-conjugates the root.  Hence ``kz**2`` always remains
+    equal to ``kz_squared`` for complex media.
+
+    With Khepri's time/propagation convention a passive dielectric is entered
+    with Im(epsilon) <= 0.  For example, the PRB paper's ``+0.001i`` loss
+    (written in the opposite harmonic convention) must be supplied to Khepri
+    as ``-0.001j``.
+    """
+    scalar = np.ndim(kz_squared) == 0
+    kz = np.sqrt(np.asarray(kz_squared, dtype=np.complex128))
+
+    # Select the outgoing root.  For a non-zero real part, positive Re(kz)
+    # fixes the propagation direction.  On the imaginary axis, choose the
+    # negative-imaginary root so exp(-i*kz*z) decays for +z.
+    flip = np.real(kz) < -atol
+    on_imag_axis = np.abs(np.real(kz)) <= atol
+    flip |= on_imag_axis & (np.imag(kz) > 0.0)
+    kz = np.where(flip, -kz, kz)
+
+    if scalar:
+        return kz.item()
+    return kz
+
 
